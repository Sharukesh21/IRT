# Environment
APP_ENV=development # development | testing | production
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-change-in-production

# API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60

# Database
# For local dev without docker:
DATABASE_URL=sqlite+aiosqlite:///./incident_test.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///./incident_test.db
# For docker/production:
# DATABASE_URL=postgresql+psycopg://appuser:changeme@db:5432/incident_regression
# ASYNC_DATABASE_URL=postgresql+psycopg://appuser:changeme@db:5432/incident_regression
