# Application
APP_NAME=incident-to-regression
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Database (PostgreSQL)
POSTGRES_DB=incident_regression_db
POSTGRES_USER=itr_user
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql://itr_user:changeme_in_production@localhost:5432/incident_regression_db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Frontend
VITE_API_URL=http://localhost:8000

# Debug (set false in production)
DEBUG=false
